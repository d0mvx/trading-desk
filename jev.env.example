# Copy to ~/.desk/jev.env (chmod 600) and paste your TypeSafe key. Jev stays OFF while no key is set.
# Key: https://console.typesafe.ai -> API Keys. Endpoint/model/thresholds are optional overrides.
JEV_API_KEY=
#JEV_MODEL=jev-1.13.0
#JEV_MIN_CONF=0.50
#JEV_MIN_NOUL=0.55
#JEV_FAIL=rule        # rule = fall back to the rule-based pick on API errors; skip = no buy
#JEV_MAX_CANDS=3      # how many gate-passing candidates (incl. RugCheck) Jev chooses from
